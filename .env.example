# Client-side (bundled into the app, so public values only).
# Local values are printed by `npx supabase start`; prod values are in Supabase > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google OAuth for local Supabase auth (read by supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server secrets (ANTHROPIC_API_KEY, CLAUDE_MODEL) go in supabase/functions/.env — see its .env.example.
